{
  "iso3": "SUR",
  "name": "Suriname",
  "language": "en",
  "key": "id_centro",
  "sources": {
    "interventions": {
      "path": "data/raw/SUR/Overview Education Infrastructure.xlsx",
      "manifest": "data/raw/SUR/overview_education_infrastructure_manifest.json",
      "sheet": 0,
      "header_row": 3,
      "columns": {
        "program_code": "Program #",
        "program_name": "Name",
        "project_name": "Name of Project",
        "works_description": "Descrition of works",
        "amount": "Amount Invested",
        "beneficiaries": "No. of Beneficiaries",
        "year": "Year"
      },
      "currency": "USD"
    },
    "schools": {
      "path": "../accessibility_platform/data/schools/AR/SUR/processed/SUR_total_cima.csv",
      "origin": "accessibility_platform, pipeline/01_build_cima.py + 02_qc_coordinates.py, built from the ministry list 'Suriname School List_03202024.xlsx'",
      "columns": {
        "id": "id_centro",
        "name": "nombre_centro",
        "lat": "latitud",
        "lon": "longitud",
        "adm1": "adm1_pcode",
        "adm2": "adm2_pcode",
        "coordinate_quality": "coordinate_quality"
      }
    },
    "school_lists": {
      "SUR-R040": {
        "kind": "lots_xlsx",
        "label": "IDB list of the ICT works (annex and bidding lots, 2026)",
        "origin": "Lists of the 113 schools of 'Small works in 113 schools' (SU-L1072), sent by the IDB on 2026-10-21",
        "annex": {
          "path": "data/raw/SUR/Annex Data base of Schools for small ICT works by lot.xlsx",
          "manifest": "data/raw/SUR/ict_annex_schools_manifest.json"
        },
        "bidding": {
          "path": "data/raw/SUR/Bidding lots small ICT works+09092026 bidding docs (113).xlsx",
          "manifest": "data/raw/SUR/ict_bidding_lots_manifest.json"
        },
        "sheet_prefix": "lot",
        "columns": {
          "name": "Schoolname:",
          "code": "Schoolcode: ",
          "district": "District:",
          "address": "Adress:",
          "lat": "Latitude",
          "lon": "Longtitude",
          "budget": "Budget",
          "type": "Type"
        },
        "fixes": "data/curation/SUR/R040_ict_fixes.json"
      },
      "SUR-R014": {
        "kind": "transcribed",
        "label": "IDB list of the bathroom works (Annex IX, 2020)",
        "origin": "Annex IX of the bidding documents for the renovation of toilet groups (110 schools in 4 interior districts), sent by the IDB on 2026-10-21 as the list for 'Improvement of 119 School Bathrooms'. PDF only; tables transcribed by hand.",
        "source": {
          "path": "data/raw/SUR/ANNEX IX - Geographical Location small file.pdf",
          "manifest": "data/raw/SUR/bathrooms_annex_ix_manifest.json"
        },
        "transcription": "data/curation/SUR/R014_bathrooms_transcribed.csv",
        "fixes": "data/curation/SUR/R014_bathrooms_fixes.json"
      }
    },
    "school_details": {
      "path": "../accessibility_platform/data/schools/AR/SUR/raw/Suriname School List_03202024.xlsx",
      "origin": "Ministry of Education school list, March 2024; the source of the school base",
      "columns": {
        "id": "School code",
        "district": "District",
        "ressort": "Ressort",
        "address": "Address"
      }
    }
  },
  "context": {
    "school_context": {
      "path": "../accessibility_platform/data/schools/AR/SUR/processed/SUR_schools_with_context.csv",
      "origin": "accessibility_platform, pipeline/06_pop_grid.py + 07_schools_context.py: WorldPop area class and Meta Relative Wealth Index (nearest cell, none past 5 km)",
      "key": "id_centro"
    },
    "boundaries": {
      "path": "../accessibility_platform/data/bounderys/LAC/level {level}/lac-level-{level}.shp",
      "origin": "IDB administrative boundaries for LAC, EPSG:4326",
      "adm0_pcode": "SUR"
    },
    "bathymetry": {
      "path": "data/raw/global/natural_earth_bathymetry/unzipped",
      "manifest": "data/raw/global/natural_earth_bathymetry/ne_10m_bathymetry_manifest.json",
      "origin": "Natural Earth 10m bathymetry 4.1.0, nested polygons per depth from SRTM Plus, public domain",
      "bbox": [-75.0, -10.0, -35.0, 20.0]
    }
  },
  "viewer": {
    "title": "School Investment Map",
    "subtitle": "Schools with IDB-financed infrastructure projects",
    "bbox": [-58.1, 1.8, -53.9, 6.9],
    "intro_bbox": [-61.5, 0.5, -49.5, 10.5],
    "programs": ["SU-L1038", "SU-L1059", "SU-L1072"],
    "list_layers": [
      {"key": "SUR-R014", "label": "Bathroom works", "icon": "drop"},
      {"key": "SUR-R040", "label": "ICT small works", "icon": "plug"}
    ],
    "program_official": {
      "origin": "IDB project pages iadb.org/en/project/SU-L1038, SU-L1059, SU-L1072; the sheet writes L-1059, L- 1072 and CAIQUES",
      "SU-L1038": {"code": "SU-L1038", "name": "BEIP 2"},
      "L-1059": {"code": "SU-L1059", "name": "CAIQES"},
      "L-1072": {"code": "SU-L1072", "name": "Skills for Growth"}
    }
  },
  "matching": {
    "school_types": {
      "OS": "O\\.?\\s*S\\.?",
      "MULO": "MULO",
      "EBGS": "EBGS",
      "LBO": "LBO",
      "VOJ": "VOJ"
    },
    "spelling_equivalences": [["OE", "U"], ["C", "K"]],
    "strip_phrases": ["fencing of", "\\(denomination(?: school)?\\)", "\\bschool\\b"],
    "non_school_patterns": ["\\bCENASU\\b", "\\blibrary\\b", "\\binspections?\\b", "\\bdepartment\\b", "\\bservice building\\b"],
    "aggregate_patterns": ["\\b\\d+\\s+schools?\\b"],
    "auto_min_score": 90,
    "auto_min_margin": 10,
    "candidate_min_score": 60
  },
  "layers": [
    {"id": "schools", "source": "schools"},
    {"id": "interventions", "source": "interventions", "group_by": "program_code"}
  ]
}
